  },
  {
   "id": "act2.callback_friendly_moa",
   "npc": "npc_moa",
   "priority": 38,
   "once": true,
   "conditions": {
    "met": "npc_moa",
    "flags_true": [
     "story.act2_complete",
     "story.act2_choice_friendly"
    ]
   },
   "lines": [

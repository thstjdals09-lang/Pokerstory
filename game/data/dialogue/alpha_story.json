  {
   "id": "act2.callback_friendly_kyle",
   "npc": "npc_kyle",
   "priority": 38,
   "once": true,
   "conditions": {
    "met": "npc_kyle",
    "flags_true": [
     "story.act2_complete",
     "story.act2_choice_friendly"
    ]
   },
   "lines": [

  {
   "id": "act2.view_juno",
   "npc": "npc_juno",
   "priority": 27,
   "once": true,
   "conditions": {
    "met": "npc_juno",
    "act": "act2"
   },
   "lines": [
    "난 루미 쪽이 좋아! 파티는 많을수록 좋잖아. …카일 말도 맞긴 한데."
   ],
   "choices": [
    {
     "text": "또 봐요",
     "action": "close"
    }

     "text": "알겠어요",
     "action": "close"
    }
   ]
  },
  {
   "id": "scn.kyle_view",
   "npc": "npc_kyle",
   "priority": 70,
   "marker": true,
   "conditions": {
    "flags_true": [
     "story.act2_started"

  {
   "id": "scn.board_reopening",
   "npc": "obj:card_room_board",
   "priority": 72,
   "conditions": {
    "flags_true": [
     "story.clue_postbox",
     "story.clue_grove"
    ],
    "flags_false": [
     "story.act1_complete"
